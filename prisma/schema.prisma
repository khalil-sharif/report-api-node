// Prisma schema for report-api-nodejs
// Primary datasource is PostgreSQL. Raw parameterized queries for report data
// are executed through PrismaClient.$queryRawUnsafe with bound parameters.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportFormat {
  pdf
  xlsx
  csv
}

enum ReportStatus {
  queued
  processing
  completed
  failed
}

/// Admin-defined report definition: the SQL, the parameter contract, the layout.
model ReportTemplate {
  id                    String   @id @default(uuid())
  name                  String
  description           String?
  /// Parameterized SQL, e.g. "SELECT * FROM orders WHERE created_at BETWEEN $1 AND $2".
  dataQuery             String   @map("data_query")
  /// Which configured connection to run against ("primary" | "analytics").
  dataSource            String   @default("primary") @map("data_source")
  /// JSON Schema-ish contract describing accepted parameters (see ParametersSchema).
  parametersSchemaJson  Json     @map("parameters_schema_json")
  /// Formats this template may be rendered to.
  supportedFormats      ReportFormat[] @map("supported_formats")
  /// Presentation config: title, columns, groupBy, sortBy, chart. See LayoutConfig.
  layoutConfigJson      Json     @map("layout_config_json")
  /// Roles permitted to generate / read this report.
  accessRoles           String[] @map("access_roles")
  /// Seconds to cache the query result set. Null => CACHE_DEFAULT_TTL.
  cacheTtlSeconds       Int?     @map("cache_ttl_seconds")
  /// Days generated reports live before cleanup. Null => DEFAULT_RETENTION_DAYS.
  retentionDays         Int?     @map("retention_days")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  generatedReports GeneratedReport[]
  schedules        ReportSchedule[]

  @@map("report_templates")
}

/// A concrete rendered artifact stored in object storage.
model GeneratedReport {
  id               String       @id @default(uuid())
  templateId       String       @map("template_id")
  template         ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parametersJson   Json         @map("parameters_json")
  format           ReportFormat
  status           ReportStatus @default(queued)
  /// Object-storage key (bucket-relative). Null until generation completes.
  filePath         String?      @map("file_path")
  fileSize         Int?         @map("file_size")
  generationTimeMs Int?         @map("generation_time_ms")
  rowCount         Int?         @map("row_count")
  error            String?
  /// User id that requested it (owner for access control).
  generatedBy      String       @map("generated_by")
  /// BullMQ job id, used to poll status.
  jobId            String?      @map("job_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  expiresAt        DateTime?    @map("expires_at")

  @@index([templateId, createdAt])
  @@index([generatedBy])
  @@index([jobId])
  @@map("generated_reports")
}

/// A recurring generation, delivered by email.
model ReportSchedule {
  id             String       @id @default(uuid())
  templateId     String       @map("template_id")
  template       ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parametersJson Json         @map("parameters_json")
  format         ReportFormat
  cronExpression String       @map("cron_expression")
  /// Email addresses to deliver to.
  recipientsJson Json         @map("recipients_json")
  createdBy      String       @map("created_by")
  isActive       Boolean      @default(true) @map("is_active")
  lastRunAt      DateTime?    @map("last_run_at")
  nextRunAt      DateTime?    @map("next_run_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([nextRunAt, isActive])
  @@index([templateId])
  @@map("report_schedules")
}
